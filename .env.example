GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OCR engine: rapid (default) | paddle | none
OCR_ENGINE=rapid
# Pages/slides read per document (0 = unlimited)
MAX_PAGES=70

# --- Render / production ---
# Frontend origin(s) allowed by CORS, comma-separated (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview deployments
# ALLOWED_ORIGIN_REGEX=https://agritech-.*\.vercel\.app
